{
  "name": "@sopheak/sp-laravel-api",
  "version": "0.0.0",
  "description": "Typed JavaScript client for the sopheak/sp-laravel-api Laravel package.",
  "license": "MIT",
  "author": "Sem Sopheak",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "bulk": [
        "./dist/bulk.d.ts"
      ],
      "attachments": [
        "./dist/attachments.d.ts"
      ],
      "audit": [
        "./dist/audit.d.ts"
      ],
      "permissions": [
        "./dist/permissions.d.ts"
      ],
      "webhooks": [
        "./dist/webhooks.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./bulk": {
      "import": {
        "types": "./dist/bulk.d.ts",
        "default": "./dist/bulk.js"
      },
      "require": {
        "types": "./dist/bulk.d.cts",
        "default": "./dist/bulk.cjs"
      }
    },
    "./attachments": {
      "import": {
        "types": "./dist/attachments.d.ts",
        "default": "./dist/attachments.js"
      },
      "require": {
        "types": "./dist/attachments.d.cts",
        "default": "./dist/attachments.cjs"
      }
    },
    "./audit": {
      "import": {
        "types": "./dist/audit.d.ts",
        "default": "./dist/audit.js"
      },
      "require": {
        "types": "./dist/audit.d.cts",
        "default": "./dist/audit.cjs"
      }
    },
    "./permissions": {
      "import": {
        "types": "./dist/permissions.d.ts",
        "default": "./dist/permissions.js"
      },
      "require": {
        "types": "./dist/permissions.d.cts",
        "default": "./dist/permissions.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check": "pnpm build && publint && attw --pack . && node scripts/check-dist.mjs && node scripts/check-modules.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
