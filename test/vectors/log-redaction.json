  "urls": [
    {
      "name": "no query",
      "input": "https://api.example.com/api/invoices",
      "expected": "https://api.example.com/api/invoices"
    },
    {
      "name": "normal query is unchanged",
      "input": "https://api.example.com/api/invoices?per_page=20&status=eq.paid",
      "expected": "https://api.example.com/api/invoices?per_page=20&status=eq.paid"
    },
    {
      "name": "token in query",
      "input": "https://api.example.com/api/invoices?token=abc123&per_page=20",
      "expected": "https://api.example.com/api/invoices?token=<redacted>&per_page=20"
    },
    {
      "name": "query key password",
      "input": "https://api.example.com/api/x?password=v1&keep=1",
      "expected": "https://api.example.com/api/x?password=<redacted>&keep=1"
    },
    {
      "name": "query key access_token",
      "input": "https://api.example.com/api/x?access_token=v1&keep=1",
      "expected": "https://api.example.com/api/x?access_token=<redacted>&keep=1"
    },
    {
      "name": "query key refresh_token",
      "input": "https://api.example.com/api/x?refresh_token=v1&keep=1",
      "expected": "https://api.example.com/api/x?refresh_token=<redacted>&keep=1"
    },
    {
      "name": "query key token",
      "input": "https://api.example.com/api/x?token=v1&keep=1",
      "expected": "https://api.example.com/api/x?token=<redacted>&keep=1"
    },
    {
      "name": "query key code",
      "input": "https://api.example.com/api/x?code=v1&keep=1",
      "expected": "https://api.example.com/api/x?code=<redacted>&keep=1"
    },
    {
      "name": "query key otp",
      "input": "https://api.example.com/api/x?otp=v1&keep=1",
      "expected": "https://api.example.com/api/x?otp=<redacted>&keep=1"
    },
    {
      "name": "query key secret",
      "input": "https://api.example.com/api/x?secret=v1&keep=1",
      "expected": "https://api.example.com/api/x?secret=<redacted>&keep=1"
    },
    {
      "name": "query key api_key",
      "input": "https://api.example.com/api/x?api_key=v1&keep=1",
      "expected": "https://api.example.com/api/x?api_key=<redacted>&keep=1"
    },
    {
      "name": "query key UPPER and Mixed-Case",
      "input": "https://api.example.com/api/x?PASSWORD=v1&Access_Token=v2&Api-Key=v3",
      "expected": "https://api.example.com/api/x?PASSWORD=<redacted>&Access_Token=<redacted>&Api-Key=<redacted>"
    },
    {
      "name": "query key ending in _token",
      "input": "https://api.example.com/api/x?device_token=v1&a=1",
      "expected": "https://api.example.com/api/x?device_token=<redacted>&a=1"
    },
    {
      "name": "percent-encoded query key",
      "input": "https://api.example.com/api/x?access%5Ftoken=v1&a=1",
      "expected": "https://api.example.com/api/x?access%5Ftoken=<redacted>&a=1"
    },
    {
      "name": "bracketed query key",
      "input": "https://api.example.com/api/x?user[password]=v1&a=1",
      "expected": "https://api.example.com/api/x?user[password]=<redacted>&a=1"
    },
    {
      "name": "sensitive key without a value",
      "input": "https://api.example.com/api/x?token&a=1",
      "expected": "https://api.example.com/api/x?token&a=1"
    },
    {
      "name": "fragment is kept",
      "input": "https://api.example.com/api/x?token=v1#top",
      "expected": "https://api.example.com/api/x?token=<redacted>#top"
    },
    {
      "name": "credentials in the authority",
      "input": "https://user:pw@api.example.com/api/x?a=1",
      "expected": "https://<redacted>@api.example.com/api/x?a=1"
    },
    {
      "name": "paths are logged verbatim",
      "input": "https://api.example.com/api/invoices/42/rpc/send",
      "expected": "https://api.example.com/api/invoices/42/rpc/send"
    }
  ]
}
