    },
    {
      "name": "tenant header value is redacted",
      "input": {
        "headers": {
          "X-Company-ID": "5",
          "Accept": "application/json"
        },
        "tenantHeader": "X-Company-ID"
      },
      "expected": {
        "X-Company-ID": "<redacted>",
        "Accept": "application/json"
      }
    },
    {
      "name": "tenant header matches case-insensitively",
      "input": {
        "headers": {
          "x-company-id": "5"
        },
        "tenantHeader": "X-Company-ID"
      },
      "expected": {
        "x-company-id": "<redacted>"
      }
    },
    {
      "name": "tenant header is left alone when none is configured",
      "input": {
        "headers": {
          "X-Company-ID": "5"
        },
        "tenantHeader": null
      },
      "expected": {
        "X-Company-ID": "5"
      }
    },
    {
      "name": "normal headers are unchanged",
      "input": {
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "X-Request-ID": "req-1"
        },
        "tenantHeader": null
      },
      "expected": {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "X-Request-ID": "req-1"
      }
    },
    {
      "name": "mixed sensitive and normal headers",
      "input": {
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer x",
          "Cookie": "a=b",
          "X-Request-ID": "r"
        },
        "tenantHeader": null
      },
      "expected": {
        "Accept": "application/json",
        "Authorization": "<redacted>",
        "Cookie": "<redacted>",
        "X-Request-ID": "r"
      }
    },
    {
      "name": "no headers",
      "input": {
        "headers": {},
        "tenantHeader": null
      },
      "expected": {}
    }
  ],
